################################
# Pebble environment variables #
################################

# Phone IP used by `mise install-phone`
IP=192.168.1.100

# Enable extra heap debug logs in Pebble C builds
# ENABLE_MEMORY_LOGGING=1

# Load deterministic app-state data from fixtures/<name>.json.
# Fixture files define watch facts, Clay render settings, and weather payloads.
# FIXTURE=readme


##################################
# Supabase environment variables #
##################################

# Optional pepper for the Rainbow proxy's stored keys (cache key, per-IP bucket); unset or blank
# falls back to the service-role key
# RAINBOW_IP_HASH_KEY=

# Supabase Edge Function endpoint for the Rainbow radar proxy, if omitted, the Rainbow radar option is hidden
# RAINBOW_PROXY_ENDPOINT=http://127.0.0.1:54321/functions/v1/rainbow-nowcast
